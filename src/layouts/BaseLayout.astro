---
import '../styles/global.css';
import { site } from '../data/site';
import CookieConsent from '../components/islands/CookieConsent.tsx';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title = `${site.name} | Premier Orthopedic & Pelvic Health Care`, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#10211b" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>(function(){try{var t=localStorage.getItem("zion-theme");var d=t==="dark"||(t==="system"&&matchMedia("(prefers-color-scheme: dark)").matches);if(d){document.documentElement.classList.add("dark");document.documentElement.style.colorScheme="dark"}}catch(e){}})()</script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/hero/hero.webp', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Singolare-Light.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Singolare-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-gold-300 focus:px-4 focus:py-3 focus:text-forest-950">Skip to content</a>
    <slot />
    <CookieConsent client:idle />
  </body>
</html>
