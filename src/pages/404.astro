  <section class="bg-cream-50 py-20 sm:py-28">
    <div class="container-x flex flex-wrap gap-3">
      <a href="/" class="btn-primary min-w-[12.5rem] justify-center">Go home</a>
      <a href="/services" class="btn-outline min-w-[12.5rem] justify-center">Our services</a>
      <a href="/locations" class="btn-outline min-w-[12.5rem] justify-center">Our locations</a>
      <a href="/contact" class="btn-outline min-w-[12.5rem] justify-center">Contact us</a>
    </div>
  </section>
</PageShell>
