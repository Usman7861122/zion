---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/islands/Header.tsx';
import CornerMark from '../../components/CornerMark.astro';
import Reveal from '../../components/islands/Reveal.tsx';
import TimelineScroll from '../../components/islands/TimelineScroll.tsx';
import ClosingCta from '../../components/ClosingCta.astro';
import Footer from '../../components/Footer.astro';
import StickyMobileBar from '../../components/StickyMobileBar.astro';
import { site } from '../../data/site';
import { categories } from '../../data/staff';

export function getStaticPaths() {
  const seen = new Map<string, any>();
  for (const c of categories) for (const p of c.people) if (p.slug && !seen.has(p.slug)) seen.set(p.slug, p);
  return [...seen.values()].map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const fix = (h: string) => (h.startsWith('#') ? '/' + h : h);
const nav = site.nav.map((i) => ({ ...i, href: fix(i.href), children: i.children?.map((c) => ({ ...c, href: fix(c.href) })) }));
const clinics = categories.filter((c) => p.clinics?.includes(c.id));
const first = p.name.replace(/^Dr\.\s*/, '').split(' ')[0];
const initials = p.name.replace(/^Dr\.\s*/, '').split(' ').map((w: string) => w[0]).slice(0, 2).join('');
const c0 = clinics[0];
const badge = p.creds.includes('OCS') ? { e: 'Board certified', t: 'Orthopedic Certified Specialist through the APTA' } : { e: c0 ? `${c0.tab} clinic` : 'Zion Physical Therapy', t: p.role };
const hasCreds = p.creds.length > 0;
const ld = {
  '@context': 'https://schema.org', '@type': 'Person', name: p.name, jobTitle: p.role,
  worksFor: { '@type': 'Physiotherapy', name: site.name }, image: p.photo,
  alumniOf: (p.education ?? []).filter((e: any) => /University/.test(e.school)).map((e: any) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
};
---
<BaseLayout title={`${p.name}, ${p.creds.slice(0, 3).join(', ')} | Physical Therapist | Zion Physical Therapy`} description={`${p.name} is ${p.role} at Zion Physical Therapy. ${p.lead ?? ''}`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Header client:load nav={nav} phone={site.phone} phoneHref={site.phoneHref} bookingUrl={site.bookingUrl} />
  <main id="content" class="pb-14 lg:pb-0">
    <section class="relative isolate mt-[72px] overflow-hidden bg-forest-900 pb-20 pt-16 text-cream-50 sm:pb-28 sm:pt-24 lg:mt-[120px]">
      <CornerMark />
      <div class="container-x relative grid items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-20">
        <div>
          <nav aria-label="Breadcrumb" class="text-sm text-sand-200"><a href="/" class="hover:text-gold-300">Home</a> <span aria-hidden="true" class="mx-2 text-gold-300">/</span> <a href="/team" class="hover:text-gold-300">Meet the Team</a> <span aria-hidden="true" class="mx-2 text-gold-300">/</span> <span>{p.name}</span></nav>
          <p class="eyebrow-dark mt-10">{p.role}</p>
          <h1 class="mt-5 text-5xl sm:text-7xl">{p.name}</h1>
          {hasCreds && <ul class="mt-7 flex flex-wrap gap-2" aria-label="Credentials">
            {p.creds.map((c: string) => <li class="rounded-md border border-gold-300/40 px-3 py-1 text-sm text-gold-300">{c}</li>)}
          </ul>}
          <p class="mt-8 max-w-xl text-xl font-light leading-relaxed text-sand-200">{p.lead}</p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={site.bookingUrl} class="btn-gold btn-book min-w-[12.5rem] justify-center">Book appointment</a>
            <a href={site.phoneHref} class="btn-outline-light min-w-[12.5rem] justify-center">Call us</a>
          </div>
        </div>
        <Reveal client:load>
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <div aria-hidden="true" class="absolute -inset-3 rounded-2xl border border-gold-300/30"></div>
            {p.photo ? <img src={p.photo} alt={`Portrait of ${p.name}`} width="800" height="1000" fetchpriority="high" class="relative aspect-[4/5] w-full rounded-xl object-cover" /> : <div class="relative grid aspect-[4/5] w-full place-items-center rounded-xl bg-forest-800 text-8xl font-light tracking-wide text-gold-300" role="img" aria-label={`Initials of ${p.name}`}>{initials}</div>}
          </div>
        </Reveal>
      </div>
    </section>

    {p.bio && (
      <section class="bg-cream-50 py-20 sm:py-28">
        <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
          <div>
            <Reveal client:visible><p class="eyebrow">About {first}</p></Reveal>
            <Reveal client:visible delay={0.08}><h2 class="mt-4 text-4xl sm:text-5xl">{p.role.includes('·') ? p.role.split('·')[0].trim() : p.role}</h2></Reveal>
          </div>
          <div class="grid gap-6 text-lg leading-relaxed text-ink-muted">
            {p.bio.map((t: string, i: number) => <Reveal client:visible delay={i * 0.08}><p>{t}</p></Reveal>)}
          </div>
        </div>
      </section>
    )}

    <!-- Areas of focus -->
    {p.focus && <section class="bg-cream-100 py-20 sm:py-28">
      <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
        <div class="lg:sticky lg:top-56 lg:self-start">
          <Reveal client:visible><p class="eyebrow">Areas of focus</p></Reveal>
          <Reveal client:visible delay={0.08}><h2 class="mt-4 text-4xl sm:text-5xl">{p.creds.length ? `Who ${first} treats` : `How ${first} helps`}</h2></Reveal>
          <Reveal client:visible delay={0.14}><p class="mt-6 max-w-sm text-lg text-ink-muted">{p.lead}</p></Reveal>
        </div>
        <ul class="border-t border-forest-900/15">
          {p.focus?.map((f: string, i: number) => (
            <li class="border-b border-forest-900/15">
              <Reveal client:visible delay={(i % 5) * 0.06}>
                <div class="group flex items-center gap-6 py-6 sm:py-7">
                  <span aria-hidden="true" class="w-8 text-sm tabular-nums text-gold-700">{String(i + 1).padStart(2, '0')}</span>
                  <p class="flex-1 text-2xl text-forest-900 transition-transform duration-500 group-hover:translate-x-2 motion-reduce:transform-none sm:text-3xl">{f}</p>
                  <span aria-hidden="true" class="block h-px w-0 bg-gold-500 transition-all duration-500 group-hover:w-12"></span>
                </div>
              </Reveal>
            </li>
          ))}
        </ul>
      </div>
    </section>}

    <!-- Credentials timeline -->
    {p.education && <section class="relative isolate overflow-hidden bg-forest-900 py-20 text-cream-50 sm:py-28">
      <CornerMark />
      <div class="container-x relative grid items-stretch gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
        <Reveal client:visible className="min-h-[22rem] lg:min-h-0">
          <div class="relative h-full min-h-[22rem] overflow-hidden rounded-2xl">
            <img src={c0?.photo ?? "/images/real/gal-4.webp"} alt={c0?.alt ?? "Treatment space at Zion Physical Therapy"} width="1200" height="1500" loading="lazy" class="absolute inset-0 size-full object-cover" />
            <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-forest-950/95 via-forest-950/40 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-7 sm:p-9">
              <p class="eyebrow-dark">{badge.e}</p>
              <p class="mt-3 max-w-xs text-2xl font-light leading-snug">{badge.t}</p>
            </div>
          </div>
        </Reveal>
        <div class="flex flex-col justify-center">
          <Reveal client:visible><p class="eyebrow-dark">Training and credentials</p></Reveal>
          <Reveal client:visible delay={0.08}><h2 class="mt-4 text-4xl sm:text-5xl">Education and training</h2></Reveal>
          <TimelineScroll client:visible items={p.education} />
        </div>
      </div>
    </section>}

    <section class="bg-cream-50 py-20 sm:py-28">
      <div class="container-x">
        <Reveal client:visible><p class="eyebrow">Where to find {first}</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="mt-4 text-4xl sm:text-5xl">Clinics</h2></Reveal>
        <ul class="mt-12 grid gap-6 md:grid-cols-2">
          {clinics.map((c, i) => (
            <li class="flex">
              <Reveal client:visible delay={i * 0.1} className="flex w-full">
                <article class="flex w-full flex-col overflow-hidden rounded-2xl border border-sand-300/70 bg-cream-50">
                  <img src={c.photo} alt={c.alt} width="1200" height="800" loading="lazy" class="aspect-[16/9] w-full object-cover" />
                  <div class="flex flex-1 flex-col p-7">
                    <p class="eyebrow">{c.kicker}</p>
                    <address class="mt-4 flex-1 text-lg not-italic text-ink-muted">{c.address}</address>
                    <div class="mt-6 flex flex-wrap gap-3">
                      <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.address ?? '')}`} class="btn-primary min-w-[12.5rem] justify-center">Get directions</a>
                      <a href={`/team#${c.id}`} class="btn-outline min-w-[12.5rem] justify-center">Meet the {c.tab} team</a>
                    </div>
                  </div>
                </article>
              </Reveal>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <ClosingCta />
  </main>
  <Footer />
  <StickyMobileBar />
</BaseLayout>
