---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/islands/Header.tsx';
import CornerMark from '../../components/CornerMark.astro';
import Reveal from '../../components/islands/Reveal.tsx';
import BlogGrid from '../../components/islands/BlogGrid.tsx';
import ClosingCta from '../../components/ClosingCta.astro';
import Footer from '../../components/Footer.astro';
import StickyMobileBar from '../../components/StickyMobileBar.astro';
import { site } from '../../data/site';
import { posts } from '../../data/posts';

const fix = (h: string) => (h.startsWith('#') ? '/' + h : h);
const nav = site.nav.map((i) => ({ ...i, href: fix(i.href), children: i.children?.map((c) => ({ ...c, href: fix(c.href) })) }));
const [lead, ...rest] = posts;
---
<BaseLayout title="Physical Therapy Blog & Insights | Zion Physical Therapy" description="Practical advice from our Doctors of Physical Therapy: dry needling, women’s health, pain relief and how to choose the right clinic.">
  <Header client:load nav={nav} phone={site.phone} phoneHref={site.phoneHref} bookingUrl={site.bookingUrl} />
  <main id="content" class="pb-14 lg:pb-0">
    <section class="relative isolate mt-[72px] overflow-hidden bg-forest-900 pb-16 pt-24 text-cream-50 sm:pb-20 sm:pt-32 lg:mt-[120px]">
      <CornerMark />
      <div class="container-x relative">
        <nav aria-label="Breadcrumb" class="text-sm text-sand-200"><a href="/" class="hover:text-gold-300">Home</a> <span aria-hidden="true" class="mx-2 text-gold-300">/</span> <span>Blog</span></nav>
        <p class="eyebrow-dark mt-8">From our blog</p>
        <h1 class="mt-5 max-w-4xl text-5xl sm:text-7xl">Practical advice from our <span class="text-gold-300">therapists</span></h1>
        <p class="mt-6 max-w-2xl text-lg text-sand-200">Clear, honest articles on pain, recovery and choosing the right care.</p>
      </div>
    </section>

    <!-- Featured -->
    <section class="bg-cream-50 pt-20 sm:pt-28">
      <div class="container-x">
        <Reveal client:visible>
          <article class="group relative grid overflow-hidden rounded-2xl border border-sand-300/70 bg-cream-100 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
            <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto lg:min-h-[28rem]">
              <img src={lead.image} alt={lead.alt} width="1200" height="900" fetchpriority="high" class="absolute inset-0 size-full object-cover transition-transform duration-[1400ms] group-hover:scale-105" />
              <span class="absolute left-5 top-5 rounded-md bg-cream-50/95 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-forest-900">Latest</span>
            </div>
            <div class="flex flex-col justify-center p-8 sm:p-12">
              <p class="eyebrow">{lead.date ? `${lead.tag} · ${lead.date}` : lead.tag}</p>
              <h2 class="mt-4 text-3xl leading-tight sm:text-4xl"><a href={lead.href} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0 after:content-[''] group-hover:text-gold-700">{lead.title}<span class="sr-only"> (opens in a new tab)</span></a></h2>
              <p class="mt-3 text-lg text-forest-900">{lead.sub}</p>
              <p class="mt-4 text-ink-muted">{lead.excerpt}</p>
              <span class="mt-8 inline-flex w-fit items-center gap-2 rounded-lg bg-forest-900 px-6 py-3 text-sm font-medium text-cream-50">Read article <span aria-hidden="true">→</span></span>
            </div>
          </article>
        </Reveal>
      </div>
    </section>

    <!-- All articles -->
    <section class="bg-cream-50 py-20 sm:py-28">
      <div class="container-x">
        <Reveal client:visible><p class="eyebrow">All articles</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="mt-4 text-4xl sm:text-5xl">Read more</h2></Reveal>
        <div class="mt-10"><BlogGrid client:load posts={rest} /></div>
      </div>
    </section>

    <ClosingCta />
  </main>
  <Footer />
  <StickyMobileBar />
</BaseLayout>
