---
import PageShell from '../../components/PageShell.astro';
import Reveal from '../../components/islands/Reveal.tsx';
import { site, locations, mapsUrl } from '../../data/site';
import { locationPages } from '../../data/locationPages';
import { services } from '../../data/care';
const embed = `https://www.google.com/maps?q=${encodeURIComponent(locations.map((l) => l.lines.join(', ')).join(' | '))}&output=embed`;
const ld = locationPages.map((p) => { const l = locations[p.locIndex]; return {
  '@context': 'https://schema.org', '@type': 'Physiotherapy', name: `Zion Physical Therapy, ${p.name}`, telephone: p.phone, url: new URL(`/locations/${p.slug}`, Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: l.lines[0], addressLocality: l.lines[1].split(',')[0], addressRegion: l.lines[1].split(', ')[1]?.split(' ')[0], postalCode: l.lines[1].split(' ').pop() } }; });
---
<PageShell title="Physical Therapy Locations: Upper East Side, Upper West Side, Jersey City & Westport | Zion PT" description="Find a Zion Physical Therapy clinic on the Upper East Side, Upper West Side, in Jersey City or in Westport, CT. Get directions, meet the team and see the services at each clinic." crumb="Locations" eyebrow="Our clinics" h1="Four clinics, one standard of care" lede="Visit us in Manhattan, Jersey City or Westport. Every clinic offers one-on-one care with a Doctor of Physical Therapy.">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="bg-cream-50 py-20 sm:py-28">
    <div class="container-x">
      <ul class="grid gap-8 md:grid-cols-2">
        {locationPages.map((p, i) => { const l = locations[p.locIndex]; return (
          <li class="flex">
            <Reveal client:visible delay={(i % 2) * 0.1} className="flex w-full">
              <article class="flex w-full flex-col overflow-hidden rounded-2xl border border-sand-300/70 bg-cream-50">
                <img src={p.photos[0].src} alt={p.photos[0].alt} width="1200" height="800" loading="lazy" class="aspect-[16/9] w-full object-cover" />
                <div class="flex flex-1 flex-col p-7 sm:p-8">
                  <p class="eyebrow">{l.area}</p>
                  <h2 class="mt-3 text-3xl text-forest-900 sm:text-4xl">{p.name}</h2>
                  <address class="mt-4 text-lg not-italic text-ink-muted">{l.lines.map((x) => <span class="block">{x}</span>)}</address>
                  <p class="mt-4 flex-1 text-ink-muted">{p.intro[0]}</p>
                  <div class="mt-7 flex flex-wrap gap-3">
                    <a href={`/locations/${p.slug}`} class="btn-primary min-w-[12.5rem] justify-center">View clinic</a>
                    <a href={mapsUrl(l)} class="btn-outline min-w-[12.5rem] justify-center">Get directions</a>
                  </div>
                </div>
              </article>
            </Reveal>
          </li>
        );})}
      </ul>
    </div>
  </section>

  <section class="bg-cream-100 py-20 sm:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <div>
        <Reveal client:visible><p class="eyebrow">At every clinic</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="mt-4 text-4xl sm:text-5xl">The same care, wherever you visit</h2></Reveal>
        <Reveal client:visible delay={0.14}><p class="mt-6 max-w-sm text-lg text-ink-muted">Not sure which clinic to choose? Call us and we will help you find the best fit.</p></Reveal>
        <Reveal client:visible delay={0.2}><div class="mt-8 flex flex-wrap gap-3"><a href={site.phoneHref} class="btn-primary min-w-[12.5rem] justify-center">Call {site.phone}</a><a href="/team" class="btn-outline min-w-[12.5rem] justify-center">Meet the team</a></div></Reveal>
      </div>
      <ul class="grid gap-x-8 sm:grid-cols-2">
        {services.map((s) => (
          <li class="border-b border-forest-900/15"><a href={`/services/${s.slug}`} class="group flex min-h-14 items-center justify-between gap-4 py-3 text-lg text-forest-900 hover:text-gold-700">{s.title}<span aria-hidden="true" class="text-gold-700 transition-transform duration-300 group-hover:translate-x-1">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</PageShell>
