---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/islands/Header.tsx';
import Hero from '../components/HeroSection.astro';
import About from '../components/AboutSection.astro';
import Specialties from '../components/FocusSection.astro';
import WhyLoveUs from '../components/WhySection.astro';
import Services from '../components/ServicesGrid.astro';
import Gallery from '../components/GallerySection.astro';
import Team from '../components/TeamSection.astro';
import HssPartner from '../components/HssSection.astro';
import TestimonialsSection from '../components/ReviewsPhotoSection.astro';
import Locations from '../components/LocationsMap.astro';
import Blog from '../components/BlogSection.astro';
import Contact from '../components/ContactSection.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Footer from '../components/Footer.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import { site } from '../data/site';
---
<BaseLayout>
  <Header client:load nav={site.nav} phone={site.phone} phoneHref={site.phoneHref} bookingUrl={site.bookingUrl} />
  <main id="content" class="pb-14 lg:pb-0">
    <Hero />
    <About />
    <Services />
    <Specialties />
    <WhyLoveUs />
    <Gallery />
    <HssPartner />
    <Team />
    <TestimonialsSection />
    <Locations />
    <Blog />
    <Contact />
    <ClosingCta />
  </main>
  <Footer />
  <StickyMobileBar />
</BaseLayout>
