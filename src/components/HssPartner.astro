---
import Reveal from './islands/Reveal.tsx';
---
<section id="hss" class="border-y border-forest-900/10 bg-cream-100 py-20 sm:py-24">
  <div class="container-x">
    <Reveal client:visible>
      <div class="grid items-center gap-10 lg:grid-cols-[auto_1fr_auto] lg:gap-16">
        <div class="flex items-center gap-6 rounded-xl bg-forest-900 p-6">
          <img src="/logos/hss-network-badge.avif" alt="HSS Rehabilitation Network badge" width="140" height="140" loading="lazy" class="h-24 w-auto" />
        </div>
        <div>
          <p class="eyebrow">Trusted partner</p>
          <h2 class="mt-4 text-3xl sm:text-4xl">HSS Rehabilitation Network</h2>
          <p class="mt-4 max-w-2xl text-ink-muted">
            Zion Physical Therapy is a participating member of the Hospital for Special Surgery Rehabilitation National Network, at our Upper East Side and Upper West Side locations. HSS is ranked #1 in the world for orthopedics.
          </p>
        </div>
        <a href="https://www.hss.edu/" target="_blank" rel="noopener noreferrer" class="btn-outline">Learn about HSS<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </Reveal>
  </div>
</section>
