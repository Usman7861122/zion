---
interface Props { updated: string }
const { updated } = Astro.props;
---
<section class="bg-cream-50 py-20 sm:py-28">
  <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-20">
    <aside class="lg:sticky lg:top-56 lg:self-start">
      <p class="eyebrow">Last updated</p>
      <p class="mt-3 text-2xl text-forest-900">{updated}</p>
      <p class="mt-6 max-w-xs text-ink-muted">Questions about this page? Call us or send a message and our team will be glad to help.</p>
      <div class="mt-6 flex flex-wrap gap-3"><a href="/contact" class="btn-primary min-w-[12.5rem] justify-center">Contact us</a></div>
    </aside>
    <div class="legal max-w-3xl text-lg leading-relaxed text-ink-muted [&_a]:text-forest-900 [&_a]:underline [&_a]:decoration-gold-500 [&_a]:underline-offset-4 [&_a:hover]:text-gold-700 [&_h2]:mb-4 [&_h2]:mt-12 [&_h2]:text-3xl [&_h2]:text-forest-900 [&_h2:first-child]:mt-0 [&_li]:mt-2 [&_p+p]:mt-4 [&_p]:mt-0 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:marker:text-gold-500">
      <slot />
    </div>
  </div>
</section>
