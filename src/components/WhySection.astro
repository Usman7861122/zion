---
import CornerMark from './CornerMark.astro';
import Reveal from './islands/Reveal.tsx';
import WhyVisual from './islands/WhyVisual.tsx';
import { site } from '../data/site';

const points = [
  { k: '1:1', t: '40 minute visits' },
  { k: 'DPT', t: 'Doctor at every visit' },
  { k: '0', t: 'Aides or hand-offs' },
];
---
<section id="why" class="relative isolate overflow-x-clip bg-forest-950 py-24 text-cream-50 sm:py-32">
  <CornerMark />
  <div class="pointer-events-none absolute -left-40 top-1/3 -z-10 aspect-square w-[520px] rounded-full bg-[radial-gradient(closest-side,rgba(214,193,119,0.10),transparent)]" aria-hidden="true"></div>
  <div class="container-x grid items-center gap-16 lg:grid-cols-2 lg:gap-24">
    <div>
      <Reveal client:visible><p class="eyebrow-dark">Why people love us</p></Reveal>
      <Reveal client:visible delay={0.08}>
        <h2 class="mt-5 text-4xl sm:text-6xl">{site.years}+ years of truly personal care</h2>
      </Reveal>
      <Reveal client:visible delay={0.16}>
        <p class="mt-7 max-w-xl text-lg text-sand-200">
          For more than {site.years} years, patients have trusted us for one-on-one attention that is hard to find. You are never handed off. You are never rushed.
        </p>
      </Reveal>
      <Reveal client:visible delay={0.24}>
        <ul class="mt-10 grid grid-cols-3 gap-4 border-t border-cream-50/15 pt-8">
          {points.map((p) => (
            <li>
              <p class="text-3xl font-light text-gold-300 sm:text-4xl">{p.k}</p>
              <p class="mt-2 text-sm text-sand-200">{p.t}</p>
            </li>
          ))}
        </ul>
        <a href="#contact" class="btn-gold mt-10">Contact Us</a>
      </Reveal>
    </div>

    <Reveal client:visible delay={0.1}>
      <div class="pb-6">
        <WhyVisual client:visible src="/images/gallery/movement.webp" years={site.years} />
      </div>
    </Reveal>
  </div>
</section>
