---
import Reveal from './islands/Reveal.tsx';
import { posts, blogUrl } from '../data/posts';
const [lead, ...rest] = posts;
---
<section id="blog" class="section-y overflow-x-clip bg-cream-50">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <Reveal client:visible><p class="eyebrow">From our blog</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="mt-5 max-w-2xl text-balance text-4xl sm:text-5xl">Practical advice from our therapists</h2></Reveal>
      </div>
      <Reveal client:visible delay={0.12}>
        <a href={blogUrl} class="link-arrow shrink-0">View all articles <span aria-hidden="true">→</span></a>
      </Reveal>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
      <!-- Featured -->
      <Reveal client:visible delay={0.1}>
        <article class="group relative">
          <a href={lead.href} target="_blank" rel="noopener noreferrer" class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500">
            <div class="relative aspect-square overflow-hidden rounded-xl bg-sand-200 shadow-[0_40px_70px_-40px_rgba(16,33,27,0.5)]">
              <img src={lead.image} alt={lead.alt} width="1200" height="1200" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-[1400ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.07]" />
              <div class="absolute inset-0 bg-gradient-to-t from-forest-950/70 via-transparent to-transparent"></div>
              <span class="absolute left-5 top-5 rounded-md bg-cream-50/95 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-forest-900">{lead.tag}</span>
              <span aria-hidden="true" class="absolute right-5 top-5 grid size-12 -rotate-45 place-items-center rounded-lg bg-cream-50 text-forest-900 transition-all duration-500 group-hover:rotate-0 group-hover:bg-gold-300">→</span>
              <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
                <p class="text-sm text-cream-50/80">{lead.date}</p>
                <h3 class="mt-2 max-w-lg text-2xl font-normal leading-tight text-cream-50 sm:text-4xl">{lead.title}</h3>
                <p class="mt-2 max-w-md text-cream-50/85">{lead.sub}</p>
              </div>
            </div>
            <span class="sr-only">Read article (opens in a new tab)</span>
          </a>
        </article>
      </Reveal>

      <!-- Side list -->
      <ul class="flex flex-col gap-6">
        {rest.map((p, i) => (
          <li class="flex-1">
            <Reveal client:visible delay={0.18 + i * 0.1} className="h-full">
              <article class="group h-full rounded-xl bg-cream-100 p-4 ring-1 ring-forest-900/10 transition-all duration-500 hover:-translate-y-1 hover:bg-white hover:shadow-[0_30px_50px_-30px_rgba(16,33,27,0.4)] sm:p-5">
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="grid h-full items-center gap-5 sm:grid-cols-[11rem_1fr] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500">
                  <div class="aspect-square overflow-hidden rounded-lg bg-sand-200">
                    <img src={p.image} alt={p.alt} width="600" height="600" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110" />
                  </div>
                  <div>
                    <p class="flex items-center gap-3 text-sm text-ink-muted"><span class="font-semibold uppercase tracking-[0.16em] text-gold-700">{p.tag}</span><span aria-hidden="true">·</span>{p.date}</p>
                    <h3 class="mt-3 text-2xl font-normal leading-snug">{p.title}</h3>
                    <p class="mt-2 line-clamp-2 text-[0.95rem] text-ink-muted">{p.excerpt}</p>
                    <span class="mt-5 inline-flex min-h-11 items-center gap-2 border border-forest-900/40 px-5 text-sm font-semibold text-forest-900 transition-colors duration-300 group-hover:border-forest-900 group-hover:bg-forest-900 group-hover:text-cream-50">Read article <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-1.5">→</span><span class="sr-only">(opens in a new tab)</span></span>
                  </div>
                </a>
              </article>
            </Reveal>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
