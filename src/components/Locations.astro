---
import Reveal from './islands/Reveal.tsx';
import { locations, mapsUrl } from '../data/site';
---
<section id="locations" class="section-y bg-cream-50">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div>
        <Reveal client:visible><p class="eyebrow">In person &amp; online</p></Reveal>
        <Reveal client:visible delay={0.08}><h2 class="mt-5 text-4xl sm:text-5xl">Physical therapy where you are</h2></Reveal>
      </div>
      <Reveal client:visible delay={0.12}>
        <p class="max-w-lg text-lg text-ink-muted">We are open for in-person and telehealth physical therapy in Manhattan, New York, Jersey City, New Jersey and Westport, Connecticut.</p>
      </Reveal>
    </div>
    <ul class="mt-14 grid gap-px bg-forest-900/15 sm:grid-cols-2 lg:grid-cols-4">
      {locations.map((l, i) => (
        <li class="bg-cream-50">
          <Reveal client:visible delay={i * 0.07} className="h-full">
            <article class="flex h-full flex-col p-8">
              <p class="eyebrow">{l.area}</p>
              <h3 class="mt-3 text-2xl font-normal">{l.name}</h3>
              <address class="mt-5 flex-1 text-[0.98rem] not-italic text-ink-muted">
                {l.lines.map((line) => <span class="block">{line}</span>)}
              </address>
              {l.hss && <p class="mt-5 text-sm text-gold-700">HSS Rehabilitation Network location</p>}
              <a href={mapsUrl(l)} target="_blank" rel="noopener noreferrer" class="link-arrow mt-6 self-start">Get directions<span class="sr-only"> to {l.name} (opens in a new tab)</span> <span aria-hidden="true">→</span></a>
            </article>
          </Reveal>
        </li>
      ))}
    </ul>
  </div>
</section>
