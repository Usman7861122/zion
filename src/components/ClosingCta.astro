---
import CornerMark from './CornerMark.astro';
import Reveal from './islands/Reveal.tsx';
import { site } from '../data/site';
---
<section class="relative isolate bg-forest-950 py-24 text-center text-cream-50 sm:py-32">
  <CornerMark />
  <div class="container-x">
    <Reveal client:visible>
      <p class="eyebrow-dark">Your next step</p>
      <h2 class="mx-auto mt-5 max-w-3xl text-5xl sm:text-7xl">Ready to feel better?</h2>
      <p class="mx-auto mt-6 max-w-xl text-lg text-sand-200">Connect with our team for fast, effective physical therapy tailored to you.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={site.bookingUrl} class="btn-gold btn-book">Book Appointment</a>
        <a href={site.phoneHref} class="btn-outline-light">{site.phone}</a>
      </div>
    </Reveal>
  </div>
</section>
