---
import Reveal from './islands/Reveal.tsx';
const pillars = [
  { n: '01', t: 'Leave it to us', d: 'Tell us what is holding you back. We build the plan and guide you through every step.' },
  { n: '02', t: 'Everything you need', d: 'Hands-on treatment, exercise coaching and clear advice, together in one visit.' },
  { n: '03', t: 'Dedicated and qualified staff', d: 'Your care comes from a licensed Doctor of Physical Therapy, never from an aide.' },
];
---
{/* "Fixed window" parallax: the photo stays still while the page scrolls past it. clip-path keeps it inside this section and also works on iPhones. */}
<section class="relative isolate flex min-h-[100svh] items-center overflow-hidden pb-44 pt-28 text-cream-50 sm:pb-56 sm:pt-36" style="clip-path: inset(0)">
  <div class="fixed inset-0 -z-10" aria-hidden="true">
    <img src="/images/real/gal-4.webp" alt="" width="1800" height="1013" loading="lazy" class="size-full object-cover" />
    <div class="absolute inset-0 bg-forest-950/70"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-forest-950/60 via-transparent to-forest-950/70"></div>
  </div>
  <div class="container-x">
    <div class="max-w-4xl">
      <Reveal client:visible><p class="eyebrow-dark">Our philosophy</p></Reveal>
      <Reveal client:visible delay={0.08}><h2 class="mt-6 text-5xl sm:text-7xl">Personalized, exceptional care. <span class="text-gold-300">Patients first.</span></h2></Reveal>
      <Reveal client:visible delay={0.14}><p class="mt-8 max-w-2xl text-lg text-sand-200 sm:text-xl">Our physical therapists take an evidence-based bio-psychosocial approach in helping you achieve your rehabilitative goals.</p></Reveal>
    </div>
    <Reveal client:visible delay={0.2}>
      <ul class="mt-16 grid items-stretch gap-5 md:grid-cols-3">
        {pillars.map((p) => (
          <li class="flex">
            <div class="group flex w-full flex-col rounded-xl border border-cream-50/20 bg-forest-950/50 p-8 backdrop-blur-md transition-all duration-500 hover:-translate-y-1.5 hover:border-gold-300/70 hover:bg-forest-950/70 motion-reduce:hover:translate-y-0">
              <span class="text-sm tabular-nums text-gold-300">{p.n}</span>
              <span aria-hidden="true" class="mt-4 block h-px w-10 bg-gold-300 transition-all duration-500 group-hover:w-20"></span>
              <h3 class="mt-5 min-h-[4rem] text-2xl text-cream-50 md:min-h-[4.5rem]">{p.t}</h3>
              <p class="mt-3 text-sand-200">{p.d}</p>
            </div>
          </li>
        ))}
      </ul>
    </Reveal>
  </div>
</section>
